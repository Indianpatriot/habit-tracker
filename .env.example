# Local Docker Compose & Backend Environment Variables (dummy values only)
NODE_ENV=development
PORT=5000

# MongoDB 7 container credentials (used by docker-compose.yml)
MONGO_INITDB_ROOT_USERNAME=habitadmin
MONGO_INITDB_ROOT_PASSWORD=changeme_local_mongo_password_123
MONGO_DB=habitgraph

# Used when running backend outside Docker Compose (e.g. npm run dev)
MONGO_URI=mongodb://habitadmin:changeme_local_mongo_password_123@localhost:27017/habitgraph?authSource=admin

# Must be at least 32 characters long
JWT_SECRET=dummy_local_jwt_secret_key_at_least_32_characters_long

# Allowed CORS origins (comma-separated)
CLIENT_ORIGIN=http://localhost:5173
