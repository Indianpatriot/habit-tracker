# Copy this file to terraform.tfvars and fill in real values (never commit terraform.tfvars)
region             = "ap-south-1"
environment        = "prod"
instance_type      = "t3.micro"
ebs_volume_size_gb = 20
project_name       = "habit-tracker"
alert_email        = "alerts@example.com"
allowed_admin_cidr = ""

